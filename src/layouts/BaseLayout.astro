---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";
---
<html
  lang="en"
  class="scroll-smooth selection:bg-accent selection:text-white no-touchevents hydrated"
>
  <head>
    <BaseHead />
  </head>
  <body class="bg-blue-verylight2 text-black flex flex-col min-h-svh">
    <Navigation/>
    <main class="grow"><slot /></main>
    <Footer/>
    
    <script is:inline>
      // Capitalize standalone 'I' pronouns after lowercase transform
      document.addEventListener('DOMContentLoaded', function() {
        const textNodes = [];
        const walker = document.createTreeWalker(
          document.body,
          NodeFilter.SHOW_TEXT,
          {
            acceptNode: function(node) {
              // Skip script, style, and other non-text elements
              const parent = node.parentElement;
              if (!parent || parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE' || 
                  parent.tagName === 'CODE' || parent.tagName === 'PRE' ||
                  parent.tagName === 'SVG' || parent.tagName === 'IMG' ||
                  parent.classList.contains('uppercase')) {
                return NodeFilter.FILTER_REJECT;
              }
              return NodeFilter.FILTER_ACCEPT;
            }
          }
        );
        
        let node;
        while (node = walker.nextNode()) {
          if (node.textContent.trim()) {
            textNodes.push(node);
          }
        }
        
        textNodes.forEach(textNode => {
          let text = textNode.textContent;
          // Capitalize 'AI' first (standalone word, case-insensitive)
          text = text.replace(/\bai\b/gi, 'AI');
          // Capitalize standalone 'I' and contractions (I'm, I've, I'll, I'd)
          // Handle contractions first to avoid double replacement
          text = text.replace(/\bi'm\b/gi, "I'm");
          text = text.replace(/\bi've\b/gi, "I've");
          text = text.replace(/\bi'll\b/gi, "I'll");
          text = text.replace(/\bi'd\b/gi, "I'd");
          // Then handle standalone 'I' (must come after contractions)
          text = text.replace(/\bi\b/g, 'I');
          if (text !== textNode.textContent) {
            textNode.textContent = text;
          }
        });
      });
    </script>
  </body>
</html>
