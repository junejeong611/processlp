---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";
---
<html
  lang="en"
  class="scroll-smooth selection:bg-accent selection:text-white no-touchevents hydrated"
>
  <head>
    <BaseHead />
  </head>
  <body class="bg-blue-verylight2 text-black flex flex-col min-h-svh">
    <Navigation/>
    <main class="grow"><slot /></main>
    <Footer/>
    
    <script is:inline>
      // Capitalize standalone 'I' pronouns and 'AI' after lowercase transform
      // CSS text-transform applies lowercase, so we need to wrap I and AI in spans
      // with text-transform: none to prevent CSS from lowercasing them
      function capitalizePronouns() {
        const textNodes = [];
        const walker = document.createTreeWalker(
          document.body,
          NodeFilter.SHOW_TEXT,
          {
            acceptNode: function(node) {
              // Skip script, style, and other non-text elements
              const parent = node.parentElement;
              if (!parent || parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE' || 
                  parent.tagName === 'CODE' || parent.tagName === 'PRE' ||
                  parent.tagName === 'SVG' || parent.tagName === 'IMG' ||
                  parent.classList.contains('uppercase') ||
                  parent.classList.contains('no-lowercase')) {
                return NodeFilter.FILTER_REJECT;
              }
              return NodeFilter.FILTER_ACCEPT;
            }
          }
        );
        
        let node;
        while (node = walker.nextNode()) {
          if (node.textContent.trim()) {
            textNodes.push(node);
          }
        }
        
        textNodes.forEach(textNode => {
          let text = textNode.textContent;
          const originalText = text;
          
          // Check if text contains 'i' or 'ai' that needs capitalization
          if (!/\b(i|i'm|i've|i'll|i'd|ai)\b/i.test(text)) {
            return; // Skip if no matches
          }
          
          // Split text and wrap I/AI in spans with no-lowercase class
          const parts = text.split(/(\bi\b|\bi'm\b|\bi've\b|\bi'll\b|\bi'd\b|\bai\b)/gi);
          if (parts.length > 1) {
            const fragment = document.createDocumentFragment();
            parts.forEach((part, index) => {
              if (!part) return;
              const lowerPart = part.toLowerCase();
              if (lowerPart === 'i' || lowerPart === "i'm" || lowerPart === "i've" || 
                  lowerPart === "i'll" || lowerPart === "i'd" || lowerPart === 'ai') {
                const span = document.createElement('span');
                span.className = 'no-lowercase';
                span.style.textTransform = 'none';
                if (lowerPart === 'ai') {
                  span.textContent = 'AI';
                } else if (lowerPart === 'i') {
                  span.textContent = 'I';
                } else {
                  span.textContent = lowerPart.charAt(0).toUpperCase() + lowerPart.slice(1);
                }
                fragment.appendChild(span);
              } else {
                fragment.appendChild(document.createTextNode(part));
              }
            });
            
            // Replace the text node with the fragment
            const parent = textNode.parentNode;
            if (parent) {
              parent.replaceChild(fragment, textNode);
            }
          }
        });
      }
      
      // Run when DOM is ready and after a delay
      function startCapitalization() {
        capitalizePronouns();
        // Run again after CSS has applied
        setTimeout(capitalizePronouns, 100);
        setTimeout(capitalizePronouns, 500);
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startCapitalization);
      } else {
        startCapitalization();
      }
      
      // Watch for DOM changes
      const observer = new MutationObserver(function() {
        setTimeout(capitalizePronouns, 50);
      });
      
      if (document.body) {
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      } else {
        document.addEventListener('DOMContentLoaded', function() {
          observer.observe(document.body, {
            childList: true,
            subtree: true
          });
        });
      }
    </script>
  </body>
</html>
