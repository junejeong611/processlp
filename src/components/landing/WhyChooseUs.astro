      <h2
        class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl lg:text-4xl mt-4 font-semibold" style="color: var(--color-text-primary)">
        everything I need for my healing journey
      </h2>
      <p class="mt-4 text-lg max-w-2xl mx-auto" style="color: var(--color-text-secondary)">
        A comprehensive mobile app designed specifically for trauma survivors, with tools for support, tracking, and regulation—all in one place.
      </p>
    </div>

    <!-- Primary Features -->
    <div class="grid gap-8 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-4 justify-center mx-auto">
      
      <!-- Trauma-Informed Support Companion -->
      <div class="p-8 rounded-2xl hover:scale-[1.02] transition bg-white shadow-sm">
        <div class="mb-6 flex justify-center">
          <div class="w-14 h-14 rounded-full flex items-center justify-center" style="background-color: #3a5a8c;">
            <svg width="28" height="28" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
              <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-center" style="color: var(--color-text-primary)">Trauma-Informed Support Companion</h3>
        <p class="text-base font-medium text-center leading-relaxed" style="color: var(--color-text-secondary)">
          Compassionate, trauma-informed emotional support available 24/7. Helps process triggers, recognize patterns, and understand trauma responses. Voice or text input—express yourself however feels comfortable.
        </p>
      </div>

      <!-- Daily Healing Tracker -->
      <div class="p-8 rounded-2xl hover:scale-[1.02] transition bg-white shadow-sm">
        <div class="mb-6 flex justify-center">
