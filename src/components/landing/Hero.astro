          </svg>
          Start Your Free Trial
        </a>
        <a href="#" class="inline-block">
          <img 
            src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83&releaseDate=1276560000" 
            alt="Download on the App Store" 
            class="h-14 w-auto"
          />
        </a>
      </div>

      <!-- Trial Info -->
      <p class="text-sm mt-4" style="color: var(--color-text-secondary)">
        7-day free trial • $11.99/month after • Cancel anytime
      </p>
      
      <!-- Key Messaging -->
      <div class="mt-10 max-w-2xl mx-auto">
        <div class="bg-white/60 backdrop-blur-sm border border-blue-200 p-6 rounded-xl">
          <p class="text-sm leading-relaxed" style="color: var(--color-text-primary)">
            <strong>NOT therapy</strong> — this is a trauma recovery resource and support tool. Designed for trauma/CPTSD with a trauma-informed approach. Available 24/7. Privacy-focused — your conversations are confidential.
          </p>
        </div>
      </div>

      <!-- Crisis Disclaimer -->
      <div class="mt-8 max-w-2xl mx-auto">
        <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded-lg">
          <p class="text-sm text-black !text-black leading-relaxed">
            <strong>Trauma Recovery Resource:</strong> ProcessIt is a trauma-informed recovery resource, not medical treatment or therapy. This tool is designed to complement professional mental health care, not replace it. If you're experiencing a crisis, please contact emergency services (911) or the 988 Suicide & Crisis Lifeline.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>