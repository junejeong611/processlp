---
const featuresList = [
  {
    title: "Process & Release",
    description: "Work through emotional triggers safely and find relief in real-time", 
  },
  {
    title: "Understand Your Patterns",
    description: "Discover your triggers, core beliefs, and trauma responses through compassionate, guided conversations",
  },
  {
    title: "Learn & Grow",
    description: "Understand the \"why\" behind your emotional responses and develop skills for lasting emotional regulation",
  },
];
import TraumaChatDemo from '../TraumaChatDemo.jsx';
---

<section id="features" class="bg-gradient-to-br from-blue-50 via-white to-blue-100 border-base-200 overflow-hidden">
  <div class="px-8 pt-14 md:pt-28 lg:pt-56 mx-auto md:px-12 lg:px-24 max-w-7xl relative pb-32">
    <div class="max-w-2xl text-center mx-auto lg:text-balance mb-10">
      <p class="text-sm leading-normal font-bold uppercase text-primary">
        Complex Trauma Support
      </p>
              <h2
          class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl capitalize lg:text-4xl mt-4 font-semibold text-primary-light">
          Process intense emotions in real-time
        </h2>
        <p class="text-lg leading-relaxed mt-2 font-medium text-primary-light opacity-80">
          Voice and text support that helps you understand and process emotions using trauma-informed principles
        </p>
      <div
        class="flex flex-wrap items-center gap-2 justify-center mx-auto mt-12">
        <a
          href="https://app.processit.app/register"
          class="flex items-center justify-center transition bg-primary-light text-white hover:bg-primary h-12 px-8 py-3 text-base font-medium rounded-lg"
        >
          Sign up
        </a>
      </div>
      
      <!-- Regulatory Disclaimer -->
      <div class="mt-8 max-w-2xl mx-auto">
        <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded-lg">
          <p class="text-sm text-gray-700 leading-relaxed">
            <strong>Important:</strong> Process is a supportive tool designed to help with emotional processing and understanding. It is not therapy, medical advice, or a replacement for professional mental health care. If you're experiencing a crisis or need immediate help, please contact emergency services (911) or the National Suicide Prevention Lifeline (988). Always consult with qualified mental health professionals for diagnosis and treatment.
          </p>
        </div>
      </div>
    </div>
    <dl
      class="lg:gap-x-8 lg:grid-cols-3 max-w-4xl mt-8 mx-auto sm:gap-x-6 sm:gap-y-12 sm:grid sm:grid-cols-3 sm:space-y-0 space-y-6 text-center text-sm items-start">
      {featuresList.map(({ title, description }) => (
        <div class="lg:text-balance" style="color: var(--color-text-secondary)">
          <strong style="color: var(--color-text-primary)">{title} ━</strong><br />
          <span class="mt-2 block">{description}</span>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- Mobile only: chat after hero -->
<section class="block md:hidden w-full">
  <div class="w-full">
    <TraumaChatDemo client:only="react" />
  </div>
</section>

<!-- Desktop: keep chat demo in hero as before -->
<section class="hidden md:block mt-16">
  <div class="relative w-full mx-auto max-w-7xl flex justify-center items-center py-12 pb-12">
    <TraumaChatDemo client:only="react" />
  </div>
</section>