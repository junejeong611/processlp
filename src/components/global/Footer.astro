---
const policyLinks = [
  { name: "Terms of Use", href: "/terms" },
  { name: "Privacy Policy", href: "/privacy" },
  { name: "AI Policy", href: "/ai-policy" },
  { name: "Crisis Resources", href: "/crisis-resources" },
  { name: "Support", href: "/support" },
];
---

<footer class="bg-gradient-to-br from-blue-50 via-white to-blue-100 border-base-200" style="background: linear-gradient(to bottom right, #D4E7F4, white, #D4E7F4);">
  <div class="px-6 md:px-12 lg:px-24 py-12 max-w-7xl mx-auto">
    
    <!-- Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      
      <!-- Brand Section -->
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <img width="40" src="/logo.svg" alt="Process logo" />
          <span class="text-lg font-semibold text-black">ProcessIt</span>
        </a>
        <p class="mt-4 text-sm" style="color: var(--color-text-secondary)">
          Trauma recovery resource and support tool. Mobile app with 24/7 compassionate support, healing tracking, and nervous system regulation tools.
        </p>
        <div class="mt-4">
          <p class="text-xs mb-2" style="color: var(--color-text-secondary)">
            Mobile App Only • iOS App Store
          </p>
          <a href="#" class="inline-block">
            <img 
              src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83&releaseDate=1276560000" 
              alt="Download on the App Store" 
              class="h-10 w-auto"
            />
          </a>
        </div>
      </div>

      <!-- Contact & Support Section -->
      <div>
        <h3 class="text-lg font-semibold text-black mb-2">
          Get Support
        </h3>
        <p class="text-sm mb-4" style="color: var(--color-text-secondary)">
          Questions, feedback, or need help? We're here for you.
        </p>
        <div class="space-y-2">
          <a 
            href="mailto:team@processit.app" 
            class="block text-sm hover:opacity-80 transition"
            style="color: #3a5a8c;"
          >
            team@processit.app
          </a>
          <a 
            href="/support" 
            class="inline-block text-sm font-medium hover:opacity-80 transition mt-2"
            style="color: #3a5a8c;"
          >
            Visit Support Page →
          </a>
        </div>
      </div>
    </div>

    <!-- Policy Links -->
    <div class="py-6 border-t" style="border-color: var(--color-bg-tertiary)">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        
        <!-- Copyright -->
        <p class="text-xs" style="color: var(--color-text-muted)">
          &copy; {new Date().getFullYear()} ProcessIt. Trauma recovery resource and support tool.
        </p>
        
        <!-- Policy Links -->
        <div class="flex flex-wrap gap-6 text-xs justify-center">
          {policyLinks.map(({ name, href }) => (
            <a
              href={href}
              class="hover:opacity-80 transition"
              style="color: var(--color-text-secondary);">
              {name}
            </a>
          ))}
        </div>
      </div>
    </div>

  </div>
</footer>