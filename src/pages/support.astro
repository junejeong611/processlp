---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="max-w-4xl mx-auto px-8 md:px-12 lg:px-24 py-16">
    
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--color-text-primary)">
        Get in Touch
      </h1>
      <p class="text-lg" style="color: var(--color-text-secondary)">
        We're here to help. Reach out with questions, feedback, or support requests.
      </p>
    </div>

    <!-- Contact Information -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      
      <!-- Primary Contact -->
      <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
        <div class="mb-4">
          <h2 class="text-xl font-semibold mb-2" style="color: var(--color-text-primary)">
            Primary Contact
          </h2>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">
            For general inquiries, support, and feedback
          </p>
        </div>
        <a 
          href="mailto:team@processit.app" 
          class="inline-flex items-center gap-2 text-lg font-medium hover:opacity-80 transition cursor-pointer"
          style="color: #3a5a8c; text-decoration: none;"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          team@processit.app
        </a>
      </div>

      <!-- Secondary Contact -->
      <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
        <div class="mb-4">
          <h2 class="text-xl font-semibold mb-2" style="color: var(--color-text-primary)">
            Alternative Contact
          </h2>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">
            For direct inquiries
          </p>
        </div>
        <a 
          href="mailto:junejeong611@gmail.com" 
          class="inline-flex items-center gap-2 text-lg font-medium hover:opacity-80 transition cursor-pointer"
          style="color: #3a5a8c; text-decoration: none;"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          junejeong611@gmail.com
        </a>
      </div>
    </div>

    <!-- Quick Action Buttons -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold mb-6 text-center" style="color: var(--color-text-primary)">
        Quick Actions
      </h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/faq" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-medium transition border-2"
          style="border-color: #3a5a8c; color: #3a5a8c;"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          View FAQ
        </a>
        <a 
          href="/crisis-resources" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-medium transition border-2"
          style="border-color: #3a5a8c; color: #3a5a8c;"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          Crisis Resources
        </a>
      </div>
    </div>

    <!-- Response Time Info -->
    <div class="p-6 rounded-lg text-center" style="background-color: #D4E7F4;">
      <p class="text-base" style="color: var(--color-text-primary)">
        <strong>Response Time:</strong> We typically respond within 24-48 hours during business days.
      </p>
      <p class="text-sm mt-2" style="color: var(--color-text-secondary)">
        For urgent matters, please use the crisis resources page or contact emergency services.
      </p>
    </div>

  </div>
</BaseLayout>

