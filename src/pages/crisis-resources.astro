---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="max-w-4xl mx-auto px-8 md:px-12 lg:px-24 py-16">
    
    <!-- Emergency Banner -->
    <div class="mb-12 p-6 rounded-lg" style="background-color: #D4E7F4;">
      <h1 class="text-2xl font-bold mb-4" style="color: var(--color-text-primary)">crisis resources & professional help</h1>
      <p class="text-base leading-relaxed" style="color: var(--color-text-secondary)">
        <strong>important:</strong> if I'm experiencing thoughts of self-harm, suicide, or am in immediate crisis, please reach out for professional help right away. processit is a supplemental tool to therapy and cannot provide crisis intervention or emergency mental health services.
      </p>
    </div>

    <!-- Immediate Crisis Help -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold mb-6" style="color: var(--color-text-primary)">immediate crisis help</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
          <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">emergency services</h3>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">if I'm in immediate danger or experiencing a life-threatening emergency:</p>
          <div class="text-center">
            <a href="tel:911" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
              call 911
            </a>
          </div>
        </div>
        
        <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
          <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">suicide prevention lifeline</h3>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">24/7 confidential support for anyone in suicidal crisis or emotional distress:</p>
          <div class="text-center">
            <a href="tel:988" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
              call 988
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Crisis Text & Chat -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold mb-6" style="color: var(--color-text-primary)">crisis text & chat support</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
          <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">crisis text line</h3>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">text HOME to 741741 to connect with a crisis counselor:</p>
          <div class="text-center">
            <a href="sms:741741&body=HOME" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
              text HOME to 741741
            </a>
          </div>
        </div>
        
        <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
          <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">988 chat</h3>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">online chat support through the suicide prevention lifeline:</p>
          <div class="text-center">
            <a href="https://988lifeline.org/chat/" target="_blank" rel="noopener noreferrer" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
              start chat
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Finding Professional Help -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold mb-6" style="color: var(--color-text-primary)">finding professional mental health care</h2>
      <div class="space-y-8">
        <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
          <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">psychology today therapist finder</h3>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">search for licensed therapists, psychiatrists, and treatment centers in my area:</p>
          <div class="text-center">
            <a href="https://www.psychologytoday.com/us/therapists" target="_blank" rel="noopener noreferrer" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
              find a therapist
            </a>
          </div>
        </div>
        
        <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
          <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">samhsa treatment locator</h3>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">find treatment facilities and programs for mental health and substance use:</p>
          <div class="text-center">
            <a href="https://findtreatment.samhsa.gov/" target="_blank" rel="noopener noreferrer" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
              find treatment
            </a>
          </div>
        </div>
        
        <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
          <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">trauma-informed therapy network</h3>
          <p class="text-sm mb-4" style="color: var(--color-text-secondary)">connect with therapists who specialize in trauma and complex PTSD:</p>
          <div class="text-center">
            <a href="https://www.istss.org/find-a-therapist" target="_blank" rel="noopener noreferrer" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
              find trauma specialists
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- How Process Complements Professional Care -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold mb-6" style="color: var(--color-text-primary)">how processit complements professional care</h2>
      <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
        <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">supplemental tool to therapy, not treatment</h3>
        <p class="text-sm mb-4" style="color: var(--color-text-secondary)">
          processit is designed as a supplemental tool that works alongside professional mental health care, not as a replacement. here's how it can support my therapy journey:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-sm" style="color: var(--color-text-secondary)">
          <li><strong>prepare for therapy sessions:</strong> use insights from processit to identify topics to discuss with my therapist</li>
          <li><strong>continue support between appointments:</strong> access supplemental support and tools when I can't access therapy</li>
          <li><strong>bridge gaps in care:</strong> provide supplemental support when professional help isn't immediately available</li>
          <li><strong>enhance self-awareness:</strong> develop insights that can make therapy more effective</li>
        </ul>
      </div>
    </div>

    <!-- Return to Learning -->
    <div class="text-center">
      <div class="p-8 rounded-2xl" style="background-color: var(--color-bg-secondary)">
        <h3 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary)">ready to continue learning?</h3>
        <p class="text-sm mb-4" style="color: var(--color-text-secondary)">
          once I'm feeling safe and stable, processit is here to help me continue my healing journey with trauma-informed support.
        </p>
        <a href="/" class="inline-block text-white px-6 py-3 rounded-lg font-medium transition hover:opacity-90" style="background-color: #3a5a8c;">
          return to home
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
