---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="max-w-4xl mx-auto px-8 md:px-12 lg:px-24 py-16">
    
    <!-- Emergency Banner -->
    <div class="mb-8 p-6 rounded-lg bg-red-50 border-l-4 border-red-400">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-red-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
        </div>
        <div class="ml-3">
          <h1 class="text-2xl font-bold text-black !text-black mb-2">Crisis Resources & Professional Help</h1>
          <p class="text-black !text-black leading-relaxed">
            <strong>Important:</strong> If you're experiencing thoughts of self-harm, suicide, or are in immediate crisis, please reach out for professional help right away. Process is an educational tool and cannot provide crisis intervention or emergency mental health services.
          </p>
        </div>
      </div>
    </div>

    <!-- Immediate Crisis Help -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-gray-800">🚨 Immediate Crisis Help</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
          <h3 class="text-xl font-semibold text-blue-800 mb-3">Emergency Services</h3>
          <p class="text-blue-700 mb-4">If you're in immediate danger or experiencing a life-threatening emergency:</p>
          <div class="text-center">
            <a href="tel:911" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
              Call 911
            </a>
          </div>
        </div>
        
        <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
          <h3 class="text-xl font-semibold text-blue-800 mb-3">Suicide Prevention Lifeline</h3>
          <p class="text-blue-700 mb-4">24/7 confidential support for anyone in suicidal crisis or emotional distress:</p>
          <div class="text-center">
            <a href="tel:988" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
              Call 988
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Crisis Text & Chat -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-gray-800">💬 Crisis Text & Chat Support</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
          <h3 class="text-xl font-semibold text-blue-800 mb-3">Crisis Text Line</h3>
          <p class="text-blue-700 mb-4">Text HOME to 741741 to connect with a crisis counselor:</p>
          <div class="text-center">
            <a href="sms:741741&body=HOME" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
              Text HOME to 741741
            </a>
          </div>
        </div>
        
        <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
          <h3 class="text-xl font-semibold text-blue-800 mb-3">988 Chat</h3>
          <p class="text-blue-700 mb-4">Online chat support through the Suicide Prevention Lifeline:</p>
          <div class="text-center">
            <a href="https://988lifeline.org/chat/" target="_blank" rel="noopener noreferrer" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
              Start Chat
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Finding Professional Help -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-gray-800">👩‍⚕️ Finding Professional Mental Health Care</h2>
      <div class="space-y-6">
        <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
          <h3 class="text-xl font-semibold text-blue-800 mb-3">Psychology Today Therapist Finder</h3>
          <p class="text-blue-700 mb-4">Search for licensed therapists, psychiatrists, and treatment centers in your area:</p>
          <div class="text-center">
            <a href="https://www.psychologytoday.com/us/therapists" target="_blank" rel="noopener noreferrer" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
              Find a Therapist
            </a>
          </div>
        </div>
        
        <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
          <h3 class="text-xl font-semibold text-blue-800 mb-3">SAMHSA Treatment Locator</h3>
          <p class="text-blue-700 mb-4">Find treatment facilities and programs for mental health and substance use:</p>
          <div class="text-center">
            <a href="https://findtreatment.samhsa.gov/" target="_blank" rel="noopener noreferrer" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
              Find Treatment
            </a>
          </div>
        </div>
        
        <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
          <h3 class="text-xl font-semibold text-blue-800 mb-3">Trauma-Informed Therapy Network</h3>
          <p class="text-blue-700 mb-4">Connect with therapists who specialize in trauma and complex PTSD:</p>
          <div class="text-center">
            <a href="https://www.istss.org/find-a-therapist" target="_blank" rel="noopener noreferrer" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
              Find Trauma Specialists
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- How Process Complements Professional Care -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-gray-800">📚 How Process Complements Professional Care</h2>
      <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
        <h3 class="text-xl font-semibold text-blue-800 mb-3">Educational Tool, Not Treatment</h3>
        <p class="text-blue-700 mb-4">
          Process is designed as an educational learning tool that works alongside professional mental health care, not as a replacement. Here's how it can complement your therapy journey:
        </p>
        <ul class="list-disc pl-6 text-blue-700 space-y-2">
          <li><strong>Prepare for therapy sessions:</strong> Use insights from Process to identify topics to discuss with your therapist</li>
          <li><strong>Continue learning between appointments:</strong> Build understanding and awareness when you can't access therapy</li>
          <li><strong>Bridge gaps in care:</strong> Provide educational support when professional help isn't immediately available</li>
          <li><strong>Enhance self-awareness:</strong> Develop insights that can make therapy more effective</li>
        </ul>
      </div>
    </div>

    <!-- Return to Learning -->
    <div class="text-center">
      <div class="p-6 rounded-lg bg-blue-50 border border-blue-200">
        <h3 class="text-xl font-semibold text-blue-800 mb-3">Ready to Continue Learning?</h3>
        <p class="text-blue-700 mb-4">
          Once you're feeling safe and stable, Process is here to help you continue your educational journey in understanding trauma responses and emotional patterns.
        </p>
        <a href="https://app.processit.app/register" class="inline-block bg-primary-light text-white px-4 py-2 rounded-md text-xs font-medium h-8 hover:bg-primary transition">
          Return to Learning
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
